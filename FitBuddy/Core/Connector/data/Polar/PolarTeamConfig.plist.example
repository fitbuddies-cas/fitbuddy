<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Team credentials for the Polar OAuth client registered at
	https://admin.polaraccesslink.com (ADR-11). Copy this file to
	"PolarTeamConfig.plist" in the same folder, fill in the two values below,
	and do not commit that copy — it is gitignored on purpose (issue #155).
	-->
	<key>PolarClientID</key>
	<string>REPLACE_ME</string>
	<key>PolarRedirectURI</key>
	<string>fitbuddy://polar/callback</string>
</dict>
</plist>
